# Generated outputs: regenerate with make tables / make figures
paper/tables/*.tex
paper/figures/*.pdf
paper/figures/*.png

# Source PDFs stay local
sources/*.pdf
sources/*.PDF

# Downloaded datasets stay local: record the URL and checksum in the result
# file instead. Many dataset licences forbid redistribution.
experiments/data/

# Tool cache
.cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and OS
.DS_Store
*.swp

# Local research output
reports/
research_notes/

# AutoResearchClaw runs and staged drafts, and its config (it can hold API keys)
arc/
config.arc.yaml
